   1:Core/Src/shoot_detect.c **** /**
   2:Core/Src/shoot_detect.c ****   ******************************************************************************
   3:Core/Src/shoot_detect.c ****   * @file           : shoot_detect.c
   4:Core/Src/shoot_detect.c ****   * @brief          : Multi-projectile barrel tracking via FIFO bitmask
   5:Core/Src/shoot_detect.c ****   * @details        : Up to BARREL_SLOTS projectiles tracked simultaneously.
   6:Core/Src/shoot_detect.c ****   *                   Rear trigger allocates a slot (sets bit → 1),
   7:Core/Src/shoot_detect.c ****   *                   front trigger drains the oldest slot (clears bit → 0).
   8:Core/Src/shoot_detect.c ****   *                   Per-slot timeout prevents stalled slots.
   9:Core/Src/shoot_detect.c ****   *                   TIM16 @ 20 kHz provides 50 µs tick resolution.
  10:Core/Src/shoot_detect.c ****   ******************************************************************************
  11:Core/Src/shoot_detect.c ****   */
  12:Core/Src/shoot_detect.c **** 
  13:Core/Src/shoot_detect.c **** #include "shoot_detect.h"
  14:Core/Src/shoot_detect.c **** #include "vcnl4040.h"
  15:Core/Src/shoot_detect.c **** #include "thermal.h"
  16:Core/Src/shoot_detect.c **** #include <string.h>
  17:Core/Src/shoot_detect.c **** 
  18:Core/Src/shoot_detect.c **** /* TIM16 is configured as 20 kHz free-running counter in main.c
  19:Core/Src/shoot_detect.c ****    (48 MHz / 2400 = 20 kHz, 50 µs/tick, wraps every 3.28 s)          */
  20:Core/Src/shoot_detect.c **** #define SPEED_TIMER             TIM16
  21:Core/Src/shoot_detect.c **** #define SPEED_TICKS_TO_MPS(t)   (1000.0f / (float)(t))
  22:Core/Src/shoot_detect.c **** 
  23:Core/Src/shoot_detect.c **** /* ========================== Static Helpers ================================== */
  24:Core/Src/shoot_detect.c **** 
  25:Core/Src/shoot_detect.c **** static inline uint16_t speed_timer_ticks(void)
  26:Core/Src/shoot_detect.c **** {
  27:Core/Src/shoot_detect.c ****     return (uint16_t)(SPEED_TIMER->CNT);
  28:Core/Src/shoot_detect.c **** }
  29:Core/Src/shoot_detect.c **** 
  30:Core/Src/shoot_detect.c **** /**
  31:Core/Src/shoot_detect.c ****   * @brief  Find index of first 0 bit in mask (returns 0..4, or -1 if full).
  32:Core/Src/shoot_detect.c ****   */
