 109:Core/Src/main.c **** /* Firmware identity and shot-to-LED trace points.
 110:Core/Src/main.c ****    This value is deliberately changed with this diagnostic build.  It lets the
 111:Core/Src/main.c ****    debugger prove which image is executing; it is not derived from the source
 112:Core/Src/main.c ****    timestamp. */
 113:Core/Src/main.c **** #if SHOOT_CAN_DIAGNOSTIC_SILENT
 114:Core/Src/main.c **** #define FW_BUILD_MAGIC  0x26091002UL /* CAN silent diagnostic image */
 115:Core/Src/main.c **** #elif SHOOT_CAN_DIAGNOSTIC_NO_APP_TX
 116:Core/Src/main.c **** #define FW_BUILD_MAGIC  0x26091004UL /* RX-only + reset-cause diagnostic */
 117:Core/Src/main.c **** #else
 118:Core/Src/main.c **** #define FW_BUILD_MAGIC  0x26083001UL /* normal operational image */
 119:Core/Src/main.c **** #endif
 120:Core/Src/main.c **** volatile uint32_t g_dbg_firmware_build_magic = FW_BUILD_MAGIC;
 121:Core/Src/main.c **** /* A mailbox accept is not yet a physical CAN ACK; it only means bxCAN took
