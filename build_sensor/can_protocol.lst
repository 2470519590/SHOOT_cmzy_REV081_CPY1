 267:Core/Src/can_protocol.c ****     payload.barrel_mask     = shoot_data.barrel_mask;
 268:Core/Src/can_protocol.c ****     payload.heat_level      = shoot_data.heat_level;
 269:Core/Src/can_protocol.c ****     __set_PRIMASK(primask);
