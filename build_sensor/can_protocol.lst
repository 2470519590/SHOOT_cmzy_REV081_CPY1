 287:Core/Src/can_protocol.c **** void CANProtocol_Task(void)
 288:Core/Src/can_protocol.c **** {
 289:Core/Src/can_protocol.c ****     uint32_t primask;
 290:Core/Src/can_protocol.c ****     uint8_t have_request;
 291:Core/Src/can_protocol.c **** 
 292:Core/Src/can_protocol.c ****     primask = __get_PRIMASK();
 293:Core/Src/can_protocol.c ****     __disable_irq();
 294:Core/Src/can_protocol.c ****     have_request = shoot_report_request_count;
 295:Core/Src/can_protocol.c ****     __set_PRIMASK(primask);
 296:Core/Src/can_protocol.c ****     if (have_request == 0U || send_shoot_report() != HAL_OK) {
 297:Core/Src/can_protocol.c ****         return;
 298:Core/Src/can_protocol.c ****     }
 299:Core/Src/can_protocol.c **** 
 300:Core/Src/can_protocol.c ****     primask = __get_PRIMASK();
 301:Core/Src/can_protocol.c ****     __disable_irq();
 302:Core/Src/can_protocol.c ****     if (shoot_report_request_count != 0U) {
 303:Core/Src/can_protocol.c ****         shoot_report_request_count--;
 304:Core/Src/can_protocol.c ****     }
 305:Core/Src/can_protocol.c ****     __set_PRIMASK(primask);
 306:Core/Src/can_protocol.c **** }
