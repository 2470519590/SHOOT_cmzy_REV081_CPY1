 170:Core/Src/can_protocol.c **** /* HAL_CAN_AddTxMessage only proves that a
 171:Core/Src/can_protocol.c ****  * mailbox accepted the frame, not that it won arbitration and received a CAN
 172:Core/Src/can_protocol.c ****  * ACK. The shot queue may be popped only after TXOK. */
 173:Core/Src/can_protocol.c **** static HAL_StatusTypeDef send_frame_confirmed(const CAN_TxHeaderTypeDef *header,
 174:Core/Src/can_protocol.c ****                                               uint8_t *payload)
 175:Core/Src/can_protocol.c **** {
 176:Core/Src/can_protocol.c ****     uint32_t mailbox = 0U;
 177:Core/Src/can_protocol.c ****     uint32_t rqcp;
 178:Core/Src/can_protocol.c ****     uint32_t txok;
 179:Core/Src/can_protocol.c ****     uint32_t started;
 180:Core/Src/can_protocol.c **** 
 181:Core/Src/can_protocol.c ****     if (can_handle == NULL || header == NULL ||
 182:Core/Src/can_protocol.c ****         HAL_CAN_GetState(can_handle) != HAL_CAN_STATE_LISTENING ||
 183:Core/Src/can_protocol.c ****         (can_handle->Instance->ESR & CAN_ESR_BOFF) != 0U) {
 184:Core/Src/can_protocol.c ****         return HAL_ERROR;
 185:Core/Src/can_protocol.c ****     }
 186:Core/Src/can_protocol.c ****     if (HAL_CAN_AddTxMessage(can_handle, (CAN_TxHeaderTypeDef *)header,
 187:Core/Src/can_protocol.c ****                              payload, &mailbox) != HAL_OK) {
 188:Core/Src/can_protocol.c ****         return HAL_ERROR;
 189:Core/Src/can_protocol.c ****     }
 190:Core/Src/can_protocol.c ****     if (mailbox == CAN_TX_MAILBOX0) {
 191:Core/Src/can_protocol.c ****         rqcp = CAN_TSR_RQCP0; txok = CAN_TSR_TXOK0;
 192:Core/Src/can_protocol.c ****     } else if (mailbox == CAN_TX_MAILBOX1) {
 193:Core/Src/can_protocol.c ****         rqcp = CAN_TSR_RQCP1; txok = CAN_TSR_TXOK1;
 194:Core/Src/can_protocol.c ****     } else if (mailbox == CAN_TX_MAILBOX2) {
 195:Core/Src/can_protocol.c ****         rqcp = CAN_TSR_RQCP2; txok = CAN_TSR_TXOK2;
 196:Core/Src/can_protocol.c ****     } else {
 197:Core/Src/can_protocol.c ****         return HAL_ERROR;
 198:Core/Src/can_protocol.c ****     }
 199:Core/Src/can_protocol.c ****     started = HAL_GetTick();
