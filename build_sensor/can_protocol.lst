 253:Core/Src/can_protocol.c **** /* ---- Send shoot status response (0x232) --------------------------------- */
 254:Core/Src/can_protocol.c **** static HAL_StatusTypeDef send_shoot_report(void)
 255:Core/Src/can_protocol.c **** {
