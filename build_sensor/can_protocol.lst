 308:Core/Src/can_protocol.c **** /* ---- LED command handler ------------------------------------------------ */
 309:Core/Src/can_protocol.c **** static bool handle_led_cmd(const CAN_LedCmd_t *rx)
 310:Core/Src/can_protocol.c **** {
 311:Core/Src/can_protocol.c ****     switch (rx->cmd) {
 312:Core/Src/can_protocol.c ****     case CAN_LED_TEAM_RED:
 313:Core/Src/can_protocol.c ****         led_cmd.source = LED_SRC_DEBUG;
 314:Core/Src/can_protocol.c ****         led_cmd.cmd    = CAN_LED_TEAM_RED;
 315:Core/Src/can_protocol.c ****         led_cmd.team   = 0;
 316:Core/Src/can_protocol.c ****         break;
 317:Core/Src/can_protocol.c ****     case CAN_LED_TEAM_BLUE:
 318:Core/Src/can_protocol.c ****         led_cmd.source = LED_SRC_DEBUG;
 319:Core/Src/can_protocol.c ****         led_cmd.cmd    = CAN_LED_TEAM_BLUE;
 320:Core/Src/can_protocol.c ****         led_cmd.team   = 1;
ARM GAS  C:\Users\24705\AppData\Local\Temp\ccBRba3t.s 			page 9


 321:Core/Src/can_protocol.c ****         break;
 322:Core/Src/can_protocol.c ****     case CAN_LED_HEAT_DATA:
 323:Core/Src/can_protocol.c ****         if (!Thermal_SetHeat(rx->heat_data, HAL_GetTick())) {
 324:Core/Src/can_protocol.c ****             return false;
 325:Core/Src/can_protocol.c ****         }
 326:Core/Src/can_protocol.c ****         /* The heat-bar display remains in automatic mode and follows the
 327:Core/Src/can_protocol.c ****            locally maintained thermal value as it subsequently cools. */
 328:Core/Src/can_protocol.c ****         led_cmd.source = LED_SRC_NORMAL;
 329:Core/Src/can_protocol.c ****         led_cmd.cmd = CAN_LED_NORMAL;
 330:Core/Src/can_protocol.c ****         led_cmd.heat_data = rx->heat_data;
 331:Core/Src/can_protocol.c ****         break;
 332:Core/Src/can_protocol.c ****     case CAN_LED_TEST_GREEN:
 333:Core/Src/can_protocol.c ****     case CAN_LED_TEST_RED:
 334:Core/Src/can_protocol.c ****     case CAN_LED_TEST_BLUE:
 335:Core/Src/can_protocol.c ****     case CAN_LED_TEST_OFF:
 336:Core/Src/can_protocol.c ****         led_cmd.source = LED_SRC_DEBUG;
 337:Core/Src/can_protocol.c ****         led_cmd.cmd    = rx->cmd;
 338:Core/Src/can_protocol.c ****         break;
 339:Core/Src/can_protocol.c ****     case CAN_LED_NORMAL:
 340:Core/Src/can_protocol.c ****         led_cmd.source = LED_SRC_NORMAL;
 341:Core/Src/can_protocol.c ****         led_cmd.cmd    = 0;
 342:Core/Src/can_protocol.c ****         break;
 343:Core/Src/can_protocol.c ****     default:
 344:Core/Src/can_protocol.c ****         return false;
 345:Core/Src/can_protocol.c ****     }
 346:Core/Src/can_protocol.c ****     return true;
 347:Core/Src/can_protocol.c **** }
