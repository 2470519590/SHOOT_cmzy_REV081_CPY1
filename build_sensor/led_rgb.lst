   1:Core/Src/led_rgb.c **** /**
   2:Core/Src/led_rgb.c ****   ******************************************************************************
   3:Core/Src/led_rgb.c ****   * @file           : led_rgb.c
   4:Core/Src/led_rgb.c ****   * @brief          : WS2812B LED strip control logic
   5:Core/Src/led_rgb.c ****   * @details        : LED[0]  = debug (occlusion → team color, idle → dim yellow)
   6:Core/Src/led_rgb.c ****   *                   LED[1-8] = heat progress bar (referee data → team color)
   7:Core/Src/led_rgb.c ****   *                   Smooth brightness lerp every 100 ms update.
   8:Core/Src/led_rgb.c ****   ******************************************************************************
   9:Core/Src/led_rgb.c ****   */
